
{
  "manifest_version": 3,
  "name": "Price Tracker",
  "version": "1.0",
  "description": "Отслеживание цен товаров",

  "permissions": [
    "activeTab",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "https://www.wildberries.ru/*",
    "https://www.ozon.ru/*",
    "https://www.letu.ru/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.wildberries.ru/*",
        "https://www.ozon.ru/*",
        "https://www.letu.ru/*"
      ],
      "js": ["content.js"]
    }
  ]
}
